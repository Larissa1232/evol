model Carrinho {
  id            Int      @id @default(autoincrement())
  user_id       String   @db.VarChar(50)
  txid          String?  @db.VarChar(100)
  produtos      String   @db.Text
  total_usd     Decimal? @db.Decimal(10,2)
  total_brl     Decimal? @db.Decimal(10,2)
  status        String   @db.VarChar(20)
  criado_em     DateTime @default(now()) @db.DateTime(0)
  atualizado_em DateTime @updatedAt @db.DateTime(0)

  @@map("carrinho")
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Produtos {
  id          Int      @id @default(autoincrement())
  image       String?  @db.VarChar(255)
  price       Decimal? @db.Decimal(10,4)
  price_brl   Decimal? @db.Decimal(10,2)
  description String?  @db.VarChar(255)
  value       String   @db.VarChar(100)
  min         Int?     @default(1)
  max         Int?     @default(1)
  ativo       Boolean  @default(true)
  descontos   Json?
  created_at  DateTime @default(now()) @db.Timestamp(6)

  @@map("produtos")
}

model Transacao {
  id          Int      @id @default(autoincrement())
  user_id     String   @db.VarChar(50)
  valor       Decimal  @db.Decimal(10,2)
  tipo        String   @db.VarChar(30) // exemplo: 'doacao', 'compra', 'pix', etc
  status      String   @db.VarChar(20)
  descricao   String?  @db.VarChar(255)
  criado_em   DateTime @default(now()) @db.DateTime(0)

  @@map("transacoes")
}
