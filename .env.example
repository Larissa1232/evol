# Example environment variables (copy to .env and fill values)
GAME_PHP_URL=http://127.0.0.1/index.php
API_SECRET_KEY=lari
# Optional: legacy GAME_HOST used by older code; prefer GAME_PHP_URL
GAME_HOST=127.0.0.1

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# OpenPix / payment
OPENPIX_API_KEY=your_openpix_api_key_here

# JWT secret for auth routes
JWT_SECRET=lari
